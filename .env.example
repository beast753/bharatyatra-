# Copy this file to ".env" (same folder) and fill in real values.
# Never commit the real ".env" file anywhere public.

# Your PostgreSQL connection string.
# Format: postgres://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=postgres://postgres:yourpassword@localhost:5432/bharatyatra

# Any long random string — used to sign login sessions.
# You can generate one at https://generate-secret.vercel.app/32
JWT_SECRET=change_this_to_a_long_random_string

# Comma-separated list of emails allowed into /admin.html
ADMIN_EMAILS=you@example.com

# Port this server runs on
PORT=4000
